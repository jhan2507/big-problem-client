# Public runtime environment for the client app
# Base URL of the backend API gateway
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Canonical site URL (used for metadata, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Notes
# - Do not add server-only secrets (e.g., database URIs, Redis) to this file.
# - Vite dev runs on :4000 via `nx run learning-platform:dev`.
# - Next server runs on :4000 via `nx run learning-platform:start` or docker compose.
